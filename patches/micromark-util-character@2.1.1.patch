+// NativeScript's embedded V8 builds without ICU, so \p{…} escapes are a
+// parse error there. Build at runtime and fall back to ASCII punctuation.
+function safeUnicodePunctuation() {
+  try {
+    return new RegExp('\\p{P}|\\p{S}', 'u')
+  } catch {
+    return /[\x21-\x2F\x3A-\x40\x5B-\x60\x7B-\x7E]/
+  }
+}
+export const unicodePunctuation = regexCheck(safeUnicodePunctuation())
 
