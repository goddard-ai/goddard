{
	"name": "octane-xplat-app",
	"private": true,
	"type": "module",
	"main": "src/main.ts",
	"scripts": {
		"xplat": "xplat",
		"dev": "vite",
		"dev:octane": "pnpm install --ignore-scripts --lockfile=false --config.pnpmfile=./links/octane.cjs",
		"dev:ios": "ns run ios --disable-npm-install",
		"dev:android": "ns run android --disable-npm-install",
		"build": "vite build",
		"build:ios": "ns build ios --disable-npm-install",
		"build:android": "ns build android --disable-npm-install",
		"lint": "xplat-lint",
		"lint:fix": "xplat-lint --fix",
		"typecheck": "tsrx-tsc --noEmit && tsrx-tsc --noEmit -p tsconfig.native.json"
	},
	"dependencies": {
		"@nativescript-community/gesturehandler": "2.0.45",
		"@nativescript-community/octane": "0.2.4",
		"@nativescript-community/ui-document-picker": "1.1.29",
		"@nativescript-community/ui-drawer": "0.1.32",
		"@nativescript/camera": "^7.0.0",
		"@nativescript/core": "9.1.3",
		"@nativescript/haptics": "^3.1.0",
		"@nativescript/imagepicker": "5.0.0",
		"@nativescript/local-notifications": "7.0.0",
		"@nativescript/mlkit-barcode-scanning": "3.0.4",
		"@nativescript/mlkit-core": "3.0.4",
		"@nativescript/secure-storage": "^4.0.2",
		"@octane-xplat/effects": "0.16.0",
		"@octane-xplat/platform": "0.16.0",
		"@octane-xplat/share": "0.16.0",
		"@octane-xplat/ui": "0.16.0",
		"@valor/nativescript-websockets": "2.0.3",
		"@waku/client": "workspace:*",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"mdast-util-from-markdown": "^2.0.3",
		"mdast-util-gfm": "^3.1.0",
		"micromark-extension-gfm": "^3.0.0",
		"octane": "0.10.2"
	},
	"devDependencies": {
		"@nativescript-community/vite-octane": "0.2.1",
		"@nativescript/android": "9.1.1",
		"@nativescript/ios": "9.1.0",
		"@nativescript/types": "9.1.4",
		"@nativescript/vite": "8.0.17",
		"@octane-xplat/cli": "0.16.0",
		"@octane-xplat/lint": "0.16.0",
		"@octanejs/vite-plugin": "0.1.61",
		"@tsrx/typescript-plugin": "0.4.11",
		"@types/mdast": "^4.0.4",
		"nativescript": "9.1.1",
		"oxlint": "^1.74.0",
		"typescript": "5.9.3",
		"vite": "8.3.0"
	},
	"packageManager": "pnpm@11.24.0"
}
