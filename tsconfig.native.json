{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"jsxImportSource": "@nativescript-community/octane",
		"moduleSuffixes": [".ios", ".android", ".mobile", ""],
		"customConditions": ["native"],
		"lib": ["ESNext"],
		"baseUrl": ".",
		"paths": { "@/*": ["./src/*"] },
		"types": ["@nativescript/types", "vite/client"],
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*", "references.d.ts"],
	"exclude": ["node_modules", "platforms", "**/*.web.*"]
}
